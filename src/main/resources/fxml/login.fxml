<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.iwish.client.LoginController" styleClass="root">
    <VBox maxWidth="420" spacing="16" alignment="CENTER" styleClass="card">
        <Label text="i-Wish 🎁" styleClass="title"/>
        <Label text="Make someone's wish come true" styleClass="subtitle"/>
        <TextField fx:id="email" promptText="Email"/>
        <PasswordField fx:id="password" promptText="Password"/>
        <Button text="Sign In" onAction="#login" maxWidth="Infinity" styleClass="primary"/>
        <Button text="Create new account" onAction="#register" maxWidth="Infinity"/>
        <Label fx:id="status" styleClass="error"/>
        <padding><Insets top="35" right="35" bottom="35" left="35"/></padding>
    </VBox>
</StackPane>
