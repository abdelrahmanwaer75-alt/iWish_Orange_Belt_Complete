<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.iwish.client.DiscoverController" styleClass="root">
<top><HBox spacing="10" styleClass="topbar"><Button text="← Back" onAction="#back"/><Label text="Friends' Wish Lists" styleClass="brand"/></HBox></top>
<center><SplitPane dividerPositions="0.35">
<VBox spacing="10" padding="15"><Label text="Your Friends" styleClass="title2"/><ListView fx:id="friendsList" VBox.vgrow="ALWAYS"/><Button text="View Wish List" onAction="#view" styleClass="primary"/></VBox>
<VBox spacing="10" padding="15"><Label text="Wish List" styleClass="title2"/><ListView fx:id="wishesList" VBox.vgrow="ALWAYS"/><HBox spacing="8"><TextField fx:id="amount" promptText="Contribution amount"/><Button text="Contribute 💝" onAction="#contribute" styleClass="primary"/></HBox><Label fx:id="status"/></VBox>
</SplitPane></center>
</BorderPane>
